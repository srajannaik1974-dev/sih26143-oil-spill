# .env.example — copy to .env and fill in your values.
# .env is gitignored and must NEVER be committed.

# ── Model checkpoint ───────────────────────────────────────────────────────────
# Absolute or relative path to the trained U-Net checkpoint.
# If this file does not exist, POST /api/ml/predict returns HTTP 503.
# Train the model first with:  python ml/training/train.py
OIL_SPILL_MODEL_PATH=ml/training/checkpoints/best_unet.pth

# ── Inference settings ─────────────────────────────────────────────────────────
# Image size the model was trained at (default 512).
OIL_SPILL_IMAGE_SIZE=512

# Probability threshold for binary oil-spill classification (default 0.5).
OIL_SPILL_THRESHOLD=0.5

# ── Upload limits ──────────────────────────────────────────────────────────────
# Maximum allowed upload size in megabytes (default 200 MB).
# A 2048x2048x2-channel float32 TIFF is ~32 MB uncompressed.
MAX_UPLOAD_MB=200

# ── Server ─────────────────────────────────────────────────────────────────────
# Host and port for uvicorn (used in start commands, not read by the app itself).
API_HOST=0.0.0.0
API_PORT=8000
